{
  "name": "hey-chat",
  "private": true,
  "workspaces": [
    "api",
    "cliente"
  ],
  "scripts": {
    "dev": "concurrently -n API,CLIENTE -c magenta,cyan \"npm run dev -w api\" \"npm run dev -w cliente\"",
    "build": "npm run build -w cliente",
    "test": "npm run test -w api",
    "db:migrate": "npm run db:migrate -w api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
