DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hey_chat
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# El cliente desplegado también está permitido explícitamente:
# https://heychat-cliente-07u5oet.apps.unbroker.cloud
# En producción usa HTTPS. Si cliente y API están en sitios distintos: COOKIE_SAME_SITE=none
COOKIE_SAME_SITE=lax
NODE_ENV=development
# Si hay exactamente un proxy confiable delante del API: TRUST_PROXY=1

# Adjuntos privados en Cloudflare R2 (solo en el API)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
